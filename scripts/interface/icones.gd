static var _cache := {}


## Texture de l'icône `name`, à `size` pixels de côté, dans la couleur `color`.
## Nom inconnu : une texture vide (jamais d'erreur à l'écran).
static func get_icon(name: String, size := 24, color := Color.WHITE) -> Texture2D:
	var key := "%s|%d|%s" % [name, size, color.to_html()]
	if _cache.has(key):
		return _cache[key]
	var inner: String = SVG.get(name, "")
	var img := Image.new()
	var svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">%s</svg>" % inner.replace("currentColor", "#" + color.to_html(false))
	var tex: Texture2D
	if inner != "" and img.load_svg_from_string(svg, float(size) / 24.0) == OK:
		tex = ImageTexture.create_from_image(img)
	else:
		var blank := Image.create(size, size, false, Image.FORMAT_RGBA8)
		tex = ImageTexture.create_from_image(blank)
	_cache[key] = tex
	return tex


static func has_icon(name: String) -> bool:
	return SVG.has(name)
